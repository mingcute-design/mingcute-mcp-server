{
  "name": "@mingcute/mcp-server",
  "version": "0.2.0",
  "description": "MCP server for searching and using MingCute icons in AI coding assistants.",
  "type": "module",
  "bin": {
    "mingcute-mcp": "bin/run.cjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:data": "node --import tsx src/scripts/build-data.ts",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build && node scripts/pack-check.mjs",
    "prepack": "npm run build",
    "verify:published": "npm run build && node scripts/verify-published.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "flexsearch": "^0.8.212",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "acorn": "^8.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "mingcute",
    "icons",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "icon-search"
  ],
  "author": "MingCute Design",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mingcute-design/mingcute-mcp-server.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
