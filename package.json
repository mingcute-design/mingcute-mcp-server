{
  "name": "@mingcute/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for searching and using MingCute icons in AI coding assistants.",
  "type": "module",
  "bin": {
    "mingcute-mcp": "bin/run.cjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
